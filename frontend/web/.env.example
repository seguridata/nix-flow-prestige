# Solo para el handshake de Socket.IO (presencia en vivo). El resto del tráfico
# va por el proxy /api/bff.
NEXT_PUBLIC_API_URL=http://localhost:3000

# OIDC (Authorization Code + PKCE) contra Keycloak — patrón BFF, tokens server-side.
KEYCLOAK_ISSUER=http://localhost:8081/realms/prestige
OIDC_CLIENT_ID=prestige-web
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT=http://localhost:3001/login

# Firma de la cookie de sesión (jose HS256). Placeholder. El valor real vive solo en .env.local. Generar con: bun run gen-keys
SESSION_SECRET=REPLACE_ME_32_BYTE_BASE64URL

# BFF al que el proxy reenvía las llamadas ya autenticadas (server-to-server,
# no interviene en OIDC). IPv4 explícito: `localhost` resuelve a ::1 primero en
# Windows y el fetch del route handler se cuelga 10 s si IPv6 no enruta.
BFF_URL=http://127.0.0.1:3000

# Proxies de confianza (LB, ingress, CDN) delante de este Next. El portal público
# de firma (/api/public-sign) usa la IP real del firmante para el límite de
# peticiones y la prueba de consentimiento. 0 = sin proxy: no se confía en
# x-forwarded-for (todos los externos compartirían la IP de este servidor, o sea
# un solo cubo del throttler). En producción detrás de un proxy: 1.
PUBLIC_TRUSTED_PROXY_HOPS=0

# Sesion del lado del servidor (tokens fuera de la cookie).
REDIS_URL=redis://localhost:6379

# Botón extra en /login que manda a Keycloak con login_hint=maria.
# No crea una sesión falsa: el realm sigue autenticando.
NEXT_PUBLIC_DEMO_SESSION=false
