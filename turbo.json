{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "BFF_URL",
        "KEYCLOAK_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_REDIRECT_URI",
        "OIDC_POST_LOGOUT_REDIRECT",
        "PUBLIC_TRUSTED_PROXY_HOPS",
        "SESSION_SECRET",
        "REDIS_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
