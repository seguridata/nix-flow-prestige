# Plantilla del archivo .env del servidor. NO guardar valores reales en el repo.
# Los secretos aleatorios se generan en el propio servidor (ver README.md) y nunca pasan por el repo.

# URLs públicas
API_PUBLIC_URL=https://api-prestige.seguridata.site
KEYCLOAK_PUBLIC_URL=https://prestige-auth.seguridata.site
KEYCLOAK_ISSUER=https://prestige-auth.seguridata.site/realms/prestige
WEB_PUBLIC_URL=https://prestige-web.vercel.app

# Postgres local (solo Keycloak y Temporal)
POSTGRES_USER=prestige
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Base de Prestige y documentos (Supabase): Session pooler, puerto 5432
DATABASE_URL=
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=prestige-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Secretos del BFF (openssl rand -base64 32)
STORAGE_MASTER_KEY=
WORKER_SHARED_SECRET=
PKI_PASSPHRASE=

# Opcionales
TSA_URL=https://freetsa.org/tsr
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
