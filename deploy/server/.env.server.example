# Plantilla de variables del servidor de Prestige. Se copia al servidor como `prestige.env`
# (permisos 600) y se usa con: docker compose --env-file prestige.env up -d
#
# LEYENDA
#   [GENERAR]  Se genera en el servidor; nunca pasa por el repo ni por el chat.
#   [USUARIO]  Lo aporta quien despliega (dominios, credenciales de Supabase y de correo).
#   [OPCIONAL] Tiene valor por defecto en el compose; descomentar solo para cambiarlo.
#   [SCRIPT]   Lo escribe provision-onboarding-admin.sh; no se llena a mano.
#
# Este archivo contiene SOLO nombres y valores de ejemplo no sensibles. No pongas secretos reales aquí.

# --- [GENERAR] Secretos aleatorios ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 24
KC_BOOTSTRAP_ADMIN_PASSWORD=
# openssl rand -base64 32 (cada uno, distinto)
STORAGE_MASTER_KEY=
WORKER_SHARED_SECRET=
PKI_PASSPHRASE=

# --- [USUARIO] Dominios públicos (por confirmar) ---
API_PUBLIC_URL=https://api-prestige.seguridata.site
KEYCLOAK_PUBLIC_URL=https://prestige-auth.seguridata.site
# Debe coincidir con el realm de Keycloak y con el dominio final de la web.
KEYCLOAK_ISSUER=https://prestige-auth.seguridata.site/realms/prestige
WEB_PUBLIC_URL=https://prestige.example.com

# --- [USUARIO] Base de Prestige en Supabase (session pooler, puerto 5432) ---
# El BFF corre `prisma migrate deploy` al iniciar: verifica que apunte a la base correcta.
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- [USUARIO] Documentos en Supabase Storage (protocolo S3) ---
S3_ENDPOINT=https://PROYECTO.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- [USUARIO] Correo saliente ---
# Sin un SMTP real, los correos (enlaces de firma incluidos) se quedan en Mailpit y no llegan a nadie.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- [USUARIO] Alta de usuarios desde onboarding ---
# Contraseña inicial TEMPORAL; Keycloak obliga a cambiarla en el primer ingreso.
ONBOARDING_DEFAULT_PASSWORD=

# --- [OPCIONAL] Valores por defecto del compose ---
# PROXY_NETWORK=proxy_net
# POSTGRES_USER=prestige
# KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
# S3_REGION=us-east-1
# S3_BUCKET=prestige-docs
# TSA_URL=https://freetsa.org/tsr
# MAIL_FROM=Prestige <no-reply@seguridata.site>
# KEYCLOAK_REALM_FILE=./prestige-realm.prod.json

# --- [SCRIPT] Los agrega provision-onboarding-admin.sh ---
# KEYCLOAK_ADMIN_CLIENT_ID=
# KEYCLOAK_ADMIN_CLIENT_SECRET=
