{
  "realm": "prestige",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "signer", "description": "Puede firmar y revisar documentos" },
      { "name": "sender", "description": "Puede crear casos y enviar solicitudes de firma" },
      { "name": "rh", "description": "Recursos Humanos: opera el onboarding e identidad" },
      { "name": "auditor", "description": "Solo lectura: expedientes, evidencia y auditoría" },
      { "name": "admin", "description": "Administración: procesos, políticas, tenants" }
    ]
  },
  "clients": [
    {
      "clientId": "prestige-web",
      "name": "Prestige Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3001/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3001", "http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "maria",
      "email": "maria@demo.local",
      "firstName": "María",
      "lastName": "González",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant": ["seguridata"] },
      "credentials": [{ "type": "password", "value": "maria123", "temporary": false }],
      "realmRoles": ["signer"]
    },
    {
      "username": "carlos",
      "email": "carlos.mendoza@empresa.com",
      "firstName": "Carlos",
      "lastName": "Mendoza",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant": ["seguridata"] },
      "credentials": [{ "type": "password", "value": "carlos123", "temporary": false }],
      "realmRoles": ["signer", "auditor"]
    },
    {
      "username": "roberto",
      "email": "roberto@empresa.com",
      "firstName": "Roberto",
      "lastName": "Gómez",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "tenant": ["seguridata"] },
      "credentials": [{ "type": "password", "value": "roberto123", "temporary": false }],
      "realmRoles": ["signer", "sender", "rh", "admin"]
    }
  ]
}
