            "url": "{{baseUrl}}/document-templates/form",
            "description": "Solo administradores. Nunca publica automáticamente; sin PDF. 409 si el formato ya está publicado.",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"name\": \"Formato digital demo\",\n  \"flow\": {\n    \"variables\": [\n      {\n        \"key\": \"fecha\",\n        \"label\": \"Fecha\",\n        \"type\": \"date\",\n        \"required\": true\n      }\n    ],\n    \"steps\": [\n      {\n        \"id\": \"solicitante\",\n        \"label\": \"Solicitante\",\n        \"role\": \"FIRMANTE\",\n        \"who\": {\n          \"type\": \"initiator\"\n        }\n      }\n    ],\n    \"order\": \"SECUENCIAL\",\n    \"slaHours\": 48\n  },\n  \"methods\": [\n    \"AUTOGRAFA\"\n  ],\n  \"attachmentSpecs\": [\n    {\n      \"key\": \"soporte\",\n      \"label\": \"Soporte\",\n      \"required\": true,\n      \"min\": 1,\n      \"max\": 3,\n      \"accept\": [\n        \"pdf\"\n      ],\n      \"maxSizeMB\": 5\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
