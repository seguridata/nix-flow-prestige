{
  "name": "@prestige/bff",
  "version": "0.1.0",
  "description": "BFF (Workflow Port + dominios de firma) de Prestige — SeguriData.",
  "private": true,
  "scripts": {
    "dev": "concurrently -n bff,worker -c cyan,magenta \"nest start --watch\" \"bun run worker:dev\"",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "worker:dev": "tsx watch src/temporal/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "sdk:gen": "openapi-typescript ../contracts/openapi.generated.json -o ../sdk/typescript/schema.d.ts"
  },
  "dependencies": {
