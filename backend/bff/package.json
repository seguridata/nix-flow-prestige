    "@nestjs/cli": "^10.4.5",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "openapi-typescript": "7.4.4",
    "prisma": "^6.19.3",
