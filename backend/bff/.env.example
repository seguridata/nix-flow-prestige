PORT=3000

# Postgres (docker compose — base "prestige")
# Pool de Prisma (por replica): en produccion anade a la URL
#   &connection_limit=10&pool_timeout=20
# connection_limit = conexiones max. por replica del BFF (y del worker);
# regla: replicas x connection_limit < max_connections de Postgres (deja margen
# para migraciones/admin, o usa PgBouncer en modo transaccion con `&pgbouncer=true`).
# pool_timeout = segundos que una consulta espera una conexion libre antes de fallar.
# Sin connection_limit Prisma usa (n_cpus * 2 + 1). Este valor NO se ha cambiado.
DATABASE_URL="postgresql://prestige:prestige@127.0.0.1:5432/prestige?schema=public"

# Keycloak (realm "prestige")
KEYCLOAK_ISSUER=http://localhost:8081/realms/prestige
# Opcional: si se define, el token debe traer esta audiencia en `aud` o `azp` (p. ej. prestige-web).
# Admite varias separadas por coma, una por cliente OIDC de tenant (prestige-web,prestige-web-tecate).
KEYCLOAK_AUDIENCE=
# Prestige MCP Streamable HTTP con OAuth Authorization Code + PKCE S256.
# En local usa la URL exacta pública del recurso; en producción debe ser HTTPS.
MCP_ENABLED=true
MCP_RESOURCE_URL=http://localhost:3000/mcp
# Vacío = audiencia igual a MCP_RESOURCE_URL.
MCP_AUDIENCE=
# Orígenes de clientes web MCP adicionales, exactos y separados por coma.
MCP_ALLOWED_ORIGINS=
# SOLO dev: acepta usuarios sin filas en TenantMembership (ignorado con NODE_ENV=production).
# Por defecto el guard de tenant es fail-closed.
ALLOW_UNMAPPED_TENANT=false

# Temporal (Workflow Port)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=prestige

# MinIO / S3-compatible (obligatorio — no hay fallback a base64 en la BD)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=prestige-docs
S3_ACCESS_KEY=prestige
S3_SECRET_KEY=prestige-minio
S3_FORCE_PATH_STYLE=true

# Cifrado en reposo de objetos — envelope AES-256-GCM (base64 de 32 bytes).
# Generar el propio con: openssl rand -base64 32
# NUNCA reutilizar este ejemplo como valor real, ni en desarrollo. En producción:
# gestionar por KMS/vault.
STORAGE_MASTER_KEY=REPLACE_ME_32_BYTE_BASE64_KEY
# Activar solo tras backfill-storage-aad.ts --apply y dry-run con pending=0.
STORAGE_REQUIRE_TENANT_AAD=false
# Temporal Cloud: TLS obligatorio con API key; mTLS alternativo por rutas a Secrets.
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_CA_PATH=
# Métricas OTLP/HTTP (contadores y latencia por tenant); vacío desactiva SDK local.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Canal interno worker -> BFF (/internal/*). Generar el propio con: openssl rand -base64 32
# NUNCA reutilizar este ejemplo como valor real, ni en desarrollo.
WORKER_SHARED_SECRET=REPLACE_ME_32_BYTE_BASE64_SECRET

# CORS: orígenes permitidos del portal (lista separada por comas)
CORS_ORIGINS=http://localhost:3001

# A-11 step-up: exigir re-autenticación reciente (@StepUp) para firmar / habilitar
# identidad. Con `true` y sin el claim `auth_time` en el token, esas acciones dan
# 403 step_up_required. El realm ya publica `auth_time` (reimportar con down -v).
STEP_UP_ENFORCE=false

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Biometría (dejar vacío = adaptador en espera; no llama a terceros)
BIOMETRIC_PROVIDER_URL=
BIOMETRIC_API_KEY=
BIOMETRIC_WEBHOOK_SECRET=

# Firma DIGITAL — custodia de llaves (Fase B / M09)
#   software = CA interna del proyecto (backend/bff/pki, gitignored). Real: PAdES verificable.
#   pkcs11   = el token firma con CKM_RSA_PKCS. La llave no sale del módulo.
#             Hacen falta PKCS11_MODULE, PKCS11_PIN, PKCS11_KEY_LABEL y,
#             si no es el primero, PKCS11_SLOT. También el paquete graphene-pk11.
#             Sin eso el BFF no firma: no cae al custodio de software.
KEY_CUSTODIAN=software
PKI_DIR=./pki
# Solo una máquina local (Keycloak y Postgres en localhost) puede usar esta
# frase: los PKCS#12 de esa máquina se cifraron con ella. NODE_ENV=production
# o un host que no sea localhost hacen que el BFF se niegue a arrancar.
# En cualquier otro entorno, genera la tuya y no copies esta línea.
PKI_PASSPHRASE=prestige-pki-dev

# TSA RFC 3161 — sello de tiempo real del expediente probatorio.
# Valor por defecto: TSA pública real (freeTSA.org). En producción: la TSA que
# opera SeguriData como PSC. Vacío = el manifiesto se sella sin RFC 3161.
TSA_URL=https://freetsa.org/tsr

# Notificaciones por correo (M13) — Mailpit en local (compose), relay real en prod.
# Vacío SMTP_HOST = la bandeja de salida se encola pero no se despacha.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prestige <no-reply@prestige.seguridata.mx>"
# URL pública del portal (para los enlaces de un solo uso del firmante externo).
PUBLIC_WEB_URL=http://localhost:3001
# TTL de los enlaces de un solo uso (horas). Por defecto 72.
ONE_TIME_LINK_TTL_HOURS=72
# Copia del PDF firmado para cada firmante (enlace de descarga en el correo de
# «completado»). Vigencia en días; el enlace no se consume al descargar. Poner
# SIGNED_COPY_TO_SIGNERS=false para no enviar copia (documentos confidenciales).
SIGNED_COPY_TO_SIGNERS=true
SIGNED_COPY_TTL_DAYS=7
# Portal externo: tras N fallos (passkey/firma rechazadas) el enlace se bloquea
# M minutos (429) sin consumirse.
PUBLIC_LINK_MAX_FAILURES=5
PUBLIC_LINK_LOCK_MINUTES=15

# WebAuthn (passkeys). Vacío = se derivan de PUBLIC_WEB_URL. Solo fijar en
# producción si el dominio público difiere del de PUBLIC_WEB_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Prestige

# Observabilidad (M15) — OpenTelemetry. Vacío = no arranca el SDK (cero overhead).
# Requiere un colector OTLP/HTTP externo (el sandbox ya no incluye uno).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=prestige-bff

# Identidad (M16)
#   OCR: tesseract.js baja `spa.traineddata` del CDN la 1ª vez; para aire-gap
#   servir los .traineddata desde TESSERACT_LANG_PATH.
TESSERACT_LANG=spa
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=
#   IdentityVerifier: heuristic (por defecto) | renapo (requiere RENAPO_URL).
IDENTITY_VERIFIER=heuristic
IDENTITY_AUTOVERIFY=false
RENAPO_URL=
RENAPO_API_KEY=
#   BiometricEngine: noop (por defecto) | local (@vladmandic/face-api, pesos en
#   FACE_MODEL_DIR) | remote (BIOMETRIC_PROVIDER_URL, el motor 3D de SeguriData).
BIOMETRIC_ENGINE=noop
FACE_MODEL_DIR=./models/face
