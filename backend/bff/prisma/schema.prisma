generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  ABIERTO
  EN_PROCESO
  CERRADO
}

model Case {
  id        String     @id @default(uuid())
  tenantId  String
  title     String
  status    CaseStatus @default(ABIERTO)
  createdAt DateTime   @default(now())

  documents Document[]

  @@index([tenantId])
}

model Document {
  id            String   @id @default(uuid())
  caseId        String
  /// A-07 — tenant denormalizado desde `Case` (como en `EvidenceManifest`) para
  /// poder aislar por tenant en las lecturas sin join.
  tenantId      String   @default("seguridata")
  filename      String
  version       Int      @default(1)
  hash          String // SHA-256 del contenido en claro
  locked        Boolean  @default(false)
  objectKey     String // clave del objeto cifrado en el storage (obligatoria)
  enc           Json // metadatos de cifrado en reposo (envelope AES-256-GCM)
  sizeBytes     Int      @default(0)
  mimeType      String   @default("application/pdf")
  createdAt     DateTime @default(now())

  case              Case               @relation(fields: [caseId], references: [id])
  signatureRequests SignatureRequest[]
  signatureFields   SignatureField[]

  @@index([caseId])
  @@index([tenantId])
}

enum SignatureMethod {
  DIGITAL
  AUTOGRAFA
  BIOMETRICA
}

enum SigningOrder {
  SECUENCIAL
  PARALELO
}

enum RequestStatus {
  PENDIENTE
  EN_FIRMA
  COMPLETADA
  RECHAZADA
  EXPIRADA
}

model SignatureRequest {
  id              String            @id @default(uuid())
  documentId      String
  /// A-07 — tenant denormalizado desde el `Document`.
  tenantId        String            @default("seguridata")
  methods         SignatureMethod[]
  order           SigningOrder      @default(SECUENCIAL)
  status          RequestStatus     @default(PENDIENTE)
  requestedBy     String?
  requestedByName String?
  slaHours        Int               @default(72)
  expiresAt       DateTime?
  /// M10 — política de firma efectiva al crear la solicitud (versión + snapshot).
  policyVersion   Int?
  policySnapshot  Json?
  createdAt       DateTime          @default(now())

  document         Document            @relation(fields: [documentId], references: [id])
  signers          Signer[]
  evidenceManifest EvidenceManifest?
  humanTasks       HumanTask[]
  consents         ConsentAcceptance[]
  workflowRun      WorkflowRun?

  @@index([documentId])
  @@index([status])
  @@index([tenantId])
}

enum SignerStatus {
  PENDIENTE
  FIRMADO
  RECHAZADO
}

enum SignerRole {
  FIRMANTE
  REVISOR
}

model Signer {
  id                  String           @id @default(uuid())
  signatureRequestId  String
  signerId            String
  name                String?
  email               String?
  role                SignerRole       @default(FIRMANTE)
  status              SignerStatus     @default(PENDIENTE)
  signedAt            DateTime?
  usedMethod          SignatureMethod?
  sortOrder           Int              @default(0)
  delegatedTo         String?
  delegatedToName     String?

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id])

  @@unique([signatureRequestId, signerId])
  @@index([signerId])
}

enum SignatureFieldType {
  SIGNATURE
  INITIALS
  DATE
  TEXT
}

/// Feature: colocación interactiva de campos de firma sobre el PDF.
model SignatureField {
  id         String             @id @default(uuid())
  documentId String
  signerId   String
  type       SignatureFieldType
  page       Int
  xPct       Float
  yPct       Float
  widthPct   Float
  heightPct  Float
  required   Boolean            @default(true)
  createdAt  DateTime           @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

/// Feature: evidencia y verificación criptográfica del expediente de firma.
/// Formaliza el prototipo `seguriflow-preservation-demo` (docs/evidencia_bpn.json).
model EvidenceManifest {
  id                   String   @id @default(uuid())
  signatureRequestId   String   @unique
  manifestId           String   @unique
  documentId           String
  documentVersion      Int
  tenantId             String
  originalHash         String
  presentedHash        String
  signedHash           String
  packageHash          String
  signingOrder         SigningOrder
  chainOfCustody       Json
  consentRecords       Json
  signatures           Json
  timestampProvider    String
  timestampIssuedAt    DateTime
  timestampTokenHash   String
  /// Token RFC 3161 (CMS SignedData, DER en base64) sobre packageHash. Null si TSA_URL no está configurada.
  timestampToken       String?  @db.Text
  /// Firma Ed25519 del JSON canónico del manifiesto (append-only, verificable offline).
  manifestHash         String?
  manifestSignature    String?
  manifestSigningKeyId String?
  /// M10 — política de firma vigente al crear la solicitud (queda dentro del
  /// manifiesto firmado, así el verificador sabe qué reglas se aplicaron).
  signaturePolicy      Json?
  validationConclusion String
  validationReasons    Json
  createdAt            DateTime @default(now())

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id])
}

enum HumanTaskStatus {
  CREADA
  ASIGNADA
  COMPLETADA
  CANCELADA
  EXPIRADA
}

model HumanTask {
  id                 String          @id @default(uuid())
  signatureRequestId String
  signerId           String
  name               String
  status             HumanTaskStatus @default(CREADA)
  /// Prioridad en la bandeja: 0 normal, 1 alta, 2+ escalada.
  priority           Int             @default(0)
  dueAt              DateTime?
  completedAt        DateTime?
  workflowId         String?
  claimedBy          String?
  claimedAt          DateTime?
  outcome            String?
  /// M07 — recordatorios/escalamiento sobre timers de Temporal.
  remindersSent      Int             @default(0)
  lastReminderAt     DateTime?
  escalatedAt        DateTime?
  /// Firmante original cuando la tarea se reasignó por delegación / «fuera de oficina».
  delegatedFrom      String?
  createdAt          DateTime        @default(now())

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id])

  @@index([signerId, status])
  @@index([signatureRequestId])
  @@index([status, priority])
}

/// M07 — «fuera de oficina»: mientras esté activo, las firmas asignadas al
/// usuario se delegan automáticamente en `delegateId` al crearse la solicitud.
model OutOfOffice {
  id           String    @id @default(uuid())
  userId       String    @unique
  delegateId   String
  delegateName String?
  reason       String?
  since        DateTime  @default(now())
  until        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ConsentAcceptance {
  id                 String   @id @default(uuid())
  signatureRequestId String
  signerId           String
  textVersion        String
  ipHash             String
  userAgentHash      String?
  acceptedAt         DateTime @default(now())

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id])

  @@unique([signatureRequestId, signerId, textVersion])
}

model WorkflowRun {
  id                 String   @id @default(uuid())
  signatureRequestId String   @unique
  workflowId         String
  runId              String?
  taskQueue          String
  processKey         String
  status             String
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id])

  @@index([workflowId])
}

model DocumentComment {
  id         String   @id @default(uuid())
  documentId String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

enum OutboxStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
  DLQ
}

/// M13 — bandeja de salida de notificaciones (correo real vía nodemailer/Mailpit)
/// con reintentos exponenciales y cola de mensajes muertos (DLQ).
model NotificationOutbox {
  id            String       @id @default(uuid())
  channel       String       @default("email")
  toAddress     String
  subject       String
  body          String       @db.Text
  template      String?
  payload       Json?
  status        OutboxStatus @default(PENDIENTE)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(6)
  lastError     String?
  nextAttemptAt DateTime     @default(now())
  sentAt        DateTime?
  /// Idempotencia: no encolar dos veces el mismo aviso.
  dedupeKey     String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

/// M14 — suscripción a webhooks firmados (HMAC-SHA256 por suscriptor).
model WebhookSubscription {
  id          String   @id @default(uuid())
  tenantId    String   @default("seguridata")
  url         String
  secret      String
  /// Tipos de evento CloudEvents a los que se suscribe (`*` = todos).
  events      String[]
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId, active])
}

/// M14 — cola de entregas de webhook con reintentos + DLQ (misma mecánica que
/// NotificationOutbox). Idempotencia por (subscriptionId, eventId).
model WebhookDelivery {
  id             String       @id @default(uuid())
  subscriptionId String
  eventType      String
  eventId        String
  payload        Json
  status         OutboxStatus @default(PENDIENTE)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(8)
  lastError      String?
  responseStatus Int?
  nextAttemptAt  DateTime     @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
}

/// M13 / A-12 — enlaces de un solo uso firmados con expiración para el portal
/// del firmante externo. Se guarda sólo el hash del token.
model OneTimeLink {
  id                 String    @id @default(uuid())
  purpose            String    @default("sign")
  signatureRequestId String?
  signerId           String
  tokenHash          String    @unique
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([signerId])
  @@index([signatureRequestId])
}

model ProcessDefinition {
  id          String   @id @default(uuid())
  key         String
  name        String
  description String?
  version     Int      @default(1)
  bpmnXml     String   @db.Text
  dmnXml      String?  @db.Text
  decisionRules Json?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
}

/// M11 — auditoría inmutable encadenada. Cada evento lleva `seq` monótono,
/// `prevHash` (hash del anterior) y `hash` = SHA-256(prevHash + JSON canónico).
/// La cabeza global vive en `AuditAnchor` y se toma con `FOR UPDATE` al escribir.
model ProcessAuditEvent {
  id                 String   @id @default(uuid())
  seq                BigInt?  @unique
  prevHash           String?
  hash               String?
  signatureRequestId String?
  documentId         String?
  onboardingId       String?
  actorId            String
  actorName          String?
  action             String
  payload            Json?
  createdAt          DateTime @default(now())

  @@index([signatureRequestId, createdAt])
  @@index([documentId, createdAt])
  @@index([onboardingId, createdAt])
  @@index([seq])
}

/// Fase B — sello de tiempo RFC 3161 por evento de firma (además del sello del
/// paquete en el manifiesto): «esta firma existía en el instante T».
model SignatureEventTimestamp {
  id                 String   @id @default(uuid())
  signatureRequestId String
  signerId           String
  /// Hash (hex) sobre el que se pidió el sello — el de la firma PAdES de ese evento.
  signedHash         String
  provider           String
  tokenHash          String
  token              String   @db.Text
  issuedAt           DateTime
  createdAt          DateTime @default(now())

  @@unique([signatureRequestId, signerId])
}

/// M11 — cabeza (singleton) de la cadena de auditoría global.
model AuditAnchor {
  id        String   @id
  seq       BigInt   @default(0)
  hash      String   @default("")
  updatedAt DateTime @updatedAt
}

model ProcessWatcher {
  id                 String   @id @default(uuid())
  signatureRequestId String
  userId             String
  name               String?
  createdAt          DateTime @default(now())

  @@unique([signatureRequestId, userId])
}

/// M15 — control plane. Directorio de tenants del lado de la app (Keycloak
/// sigue siendo la fuente de identidad; esto complementa con metadatos,
/// membresías y políticas por tenant).
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TenantMembership[]
  policies    Policy[]
  catalogs    CatalogEntry[]
}

/// M15 — pertenencia usuario↔tenant + roles efectivos en ese tenant. Habilita
/// validar `delegateId` / destinatarios contra un directorio real (deuda A-07).
model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  name      String?
  email     String?
  roles     String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// M15 — política versionable por tenant (SLA por defecto, métodos de firma
/// permitidos, política de firma M10, ventanas de recordatorio, TTL de enlaces…).
model Policy {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     Json
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

/// M15 — catálogos por tenant (tipos de documento, motivos de rechazo, áreas…).
model CatalogEntry {
  id        String   @id @default(uuid())
  tenantId  String
  kind      String
  key       String
  label     String
  meta      Json?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, key])
  @@index([tenantId, kind])
}

enum OnboardingKind {
  EMPLEADO
  PROVEEDOR
  CLIENTE
}

enum OnboardingStatus {
  BORRADOR
  DATOS
  INE
  PRUEBA_VIDA
  EN_REVISION
  HABILITADO
  RECHAZADO
}

/// M16 — alta de empleados, proveedores o clientes antes de habilitar firma.
model OnboardingCase {
  id                 String           @id @default(uuid())
  tenantId           String
  kind               OnboardingKind   @default(EMPLEADO)
  status             OnboardingStatus @default(BORRADOR)
  fullName           String
  email              String
  curp               String?
  rfc                String?
  // Objetos cifrados en storage: { key, sha256, size, enc }. Nunca base64 en BD.
  ineFront           Json?
  ineBack            Json?
  ineHash            String?
  ineVerified        Boolean          @default(false)
  /// M16 — OCR/MRZ crudo + campos extraídos de la INE (tesseract.js).
  ineOcr             Json?
  /// M16 — resultado del puerto IdentityVerifier (vigencia / CURP / RENAPO).
  ineCheck           Json?
  selfie             Json?
  livenessHash       String?
  livenessScore      Float?
  livenessOk         Boolean          @default(false)
  faceMatchOk        Boolean          @default(false)
  /// M16 — score de face-match 0..1 del puerto BiometricEngine.
  faceMatchScore     Float?
  biometricEngine    String?
  biometricSessionId String?
  enabledSignerId    String?
  notes              String?
  requestedBy        String
  requestedByName    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([email])
}
