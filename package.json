{
  "name": "prestige",
  "private": true,
  "workspaces": [
    "frontend/*",
    "backend/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "down": "bun scripts/dev.ts down",
    "demo": "cd backend/bff && bun prisma/scripts/demo-seed.ts",
    "demo:reset": "cd backend/bff && bun prisma/scripts/demo-seed.ts --reset",
    "gen-keys": "bun scripts/gen-keys.ts",
    "pki:init": "bun scripts/pki-init.ts",
    "audit:env": "bun scripts/audit-env.ts",
    "backup:local": "bun scripts/backup-local.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
